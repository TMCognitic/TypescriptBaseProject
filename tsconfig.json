{
  "compilerOptions": {   
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "noEmitOnError": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "scripts",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["src"]
}